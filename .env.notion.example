# CR8W v3 — server-only Notion configuration.
# Copy to .env.local for development and set the same names in Vercel.
# Never commit real values. NOTION_TOKEN must not be exposed to the browser:
# do not prefix it with VITE_.

# Notion internal integration token (server-side only).
NOTION_TOKEN=

# Notion data source ids. These are identifiers, not secrets.
NOTION_FLOWS_DB=c1677843-dd13-4e37-9f80-e960b26847dc
NOTION_MOVES_DB=5597e583-f7df-4f6c-90b0-296a26c57454
NOTION_PEOPLE_DB=b97bcbdf-2b1b-488d-9d07-4012b031732e

# Public intake stays off until the consent workflow is reviewed.
INTAKE_ENABLED=false
