# CR8W Create Well — Environment Variables
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local to git — it contains secrets.
#
# For production (Vercel), set these in:
#   Vercel Dashboard → Project → Settings → Environment Variables

# ── Supabase ───────────────────────────────────────────────────────────────────
# Project URL
SUPABASE_URL=https://axntibrdivccycxdwlzk.supabase.co

# Publishable key (safe for client-side)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_KKMWtvpxkSGaq-xmie6viQ_pRzAb_4i

# Service role key (SERVER ONLY — never expose to browser)
SUPABASE_SECRET_KEY=sb_secret_xxx
# Alternative name also accepted:
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ── Google Calendar ────────────────────────────────────────────────────────────
# OAuth client secret (SERVER ONLY)
GCAL_CLIENT_SECRET=your-google-client-secret

# ── CR8W Team Calendar iCal Feed ───────────────────────────────────────────────
# Secret iCal URL for the shared team calendar
CR8W_ICAL_URL=https://calendar.google.com/calendar/ical/.../basic.ics
