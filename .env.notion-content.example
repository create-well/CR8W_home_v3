# Notion content database/data source
NOTION_TOKEN=secret_redacted
NOTION_CONTENT_DATA_SOURCE_ID=collection://replace-with-notion-data-source-id
NOTION_VERSION=2025-09-03

# Only pages whose Status matches one of these values are published.
NOTION_PUBLISHED_STATUSES=Published
NOTION_STATUS_PROPERTY=Status
NOTION_TITLE_PROPERTY=Title
NOTION_SLUG_PROPERTY=Slug
NOTION_TYPE_PROPERTY=Type
NOTION_AUDIENCE_PROPERTY=Audience
NOTION_DESCRIPTION_PROPERTY=Description

# Generated website content
CONTENT_DIR=content
NOTION_PAGE_SIZE=100
NOTION_MAX_RETRIES=3
DRY_RUN=1
