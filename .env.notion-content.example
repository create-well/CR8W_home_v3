# Notion content database/data source
NOTION_TOKEN=secret_redacted

# Preferred for the extracted Perplexity Space configuration. Uses the legacy
# database query endpoint and defaults the title property to Content Title.
NOTION_CONTENT_DB=replace-with-notion-content-database-id

# Alternative for Notion's newer data-source API. Use one source ID only.
# NOTION_CONTENT_DATA_SOURCE_ID=collection://replace-with-notion-data-source-id

# Optional. The worker chooses 2022-06-28 when NOTION_CONTENT_DB is used and
# 2025-09-03 for NOTION_CONTENT_DATA_SOURCE_ID unless this value overrides it.
# NOTION_VERSION=2025-09-03

# Only pages whose Status matches one of these values are published.
NOTION_PUBLISHED_STATUSES=Published
NOTION_STATUS_PROPERTY=Status
# The Perplexity Space uses Content Title. Use Title for a newer data source
# with that title-property name instead.
NOTION_TITLE_PROPERTY=Content Title
NOTION_SLUG_PROPERTY=Slug
NOTION_TYPE_PROPERTY=Type
NOTION_AUDIENCE_PROPERTY=Audience
NOTION_DESCRIPTION_PROPERTY=Description

# Generated website content
CONTENT_DIR=content
NOTION_PAGE_SIZE=100
NOTION_MAX_RETRIES=3
DRY_RUN=1
